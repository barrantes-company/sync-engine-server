HOST=
HTTPS_PORT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@your-domain.example
FIREBASE_SERVICE_ACCOUNT=

# Staging: use a new service and its own disk; do not copy a production .env.
APP_ENV=
DATA_DIR=
UPLOADS_DIR=
DISABLE_LOCAL_TLS=false
PUBSUB_ENABLED=false
PUBSUB_PROJECT_ID=
PUBSUB_TOPIC=
PUBSUB_SUBSCRIPTION=
CORS_ORIGINS=
SEED_DEVELOPMENT_ADMIN=false
# Set to true only in local fixtures. Never enables a real charge.
ALLOW_TEST_BILLING=false
# Optional local bridge, one dedicated upstream identity per process.
WS_BRIDGE_HOST=127.0.0.1
WS_BRIDGE_PORT=8123
WS_BRIDGE_UPSTREAM_URL=http://127.0.0.1:3000
WS_BRIDGE_TOKEN=
WS_BRIDGE_UPSTREAM_TOKEN=
