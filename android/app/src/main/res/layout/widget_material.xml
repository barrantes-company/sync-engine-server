<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <ViewFlipper
        android:id="@+id/widget_flipper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:autoStart="true"
        android:flipInterval="4000"
        android:inAnimation="@anim/widget_fade_in"
        android:outAnimation="@anim/widget_fade_out">

        <ImageView
            android:id="@+id/widget_frame_a"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/widget_name"
            android:importantForAccessibility="no"
            android:scaleType="fitXY" />

        <ImageView
            android:id="@+id/widget_frame_b"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/widget_name"
            android:importantForAccessibility="no"
            android:scaleType="fitXY" />
    </ViewFlipper>

    <LinearLayout
        android:id="@+id/widget_clock_block"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="16dp"
        android:layout_marginTop="14dp"
        android:gravity="start"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_city"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:visibility="gone" />

        <TextClock
            android:id="@+id/widget_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:includeFontPadding="false"
            android:letterSpacing="-0.04"
            android:shadowColor="@color/widget_config_accent"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="12"
            android:textColor="@color/widget_material_text"
            android:textSize="48sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="monospace"
            android:textColor="@color/widget_material_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/widget_settings"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="end|top"
        android:layout_margin="4dp"
        android:alpha="0.42"
        android:background="@android:color/transparent"
        android:contentDescription="@string/configure_widget"
        android:padding="9dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_widget_settings" />
</FrameLayout>
