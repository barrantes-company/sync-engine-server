<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_glass_dark"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="14dp">
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextClock
            android:id="@+id/widget_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:includeFontPadding="false"
            android:textColor="#F7F7F5"
            android:textSize="40sp" />
        <TextClock
            android:id="@+id/widget_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="EEEE, d 'de' MMMM"
            android:format24Hour="EEEE, d 'de' MMMM"
            android:textColor="#D0D0D0"
            android:textSize="13sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/widget_action_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/widget_messages_action"
            android:layout_width="58dp"
            android:layout_height="68dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/widget_circle_dark"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_widget_chat" />
            <TextView
                android:id="@+id/widget_messages_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#F7F7F5"
                android:textSize="13sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/widget_calls_action"
            android:layout_width="58dp"
            android:layout_height="68dp"
            android:background="@drawable/widget_circle_dark"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_widget_call" />
            <TextView
                android:id="@+id/widget_calls_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#F7F7F5"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:id="@+id/widget_status"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
</LinearLayout>
