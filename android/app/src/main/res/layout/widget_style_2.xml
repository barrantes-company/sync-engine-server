<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">
    
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="36dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">
        <TextClock
            android:id="@+id/widget_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:format12Hour="h:mm a"
            android:format24Hour="HH:mm"
            android:includeFontPadding="false"
            android:letterSpacing="-0.03"
            android:textColor="#FFFFFF"
            android:textSize="44sp"
             />
        <TextClock
            android:id="@+id/widget_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif"
            android:format12Hour="EEE d MMM"
            android:format24Hour="EEE d MMM"
            android:includeFontPadding="false"
            android:textColor="#8A8A8A"
            android:textSize="12sp"
             />
        <TextView
            android:id="@+id/widget_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:minHeight="48dp"
            android:textColor="#BDBDBD"
            android:textSize="14sp"
            android:visibility="gone"
             />
        <LinearLayout
            android:id="@+id/widget_action_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:orientation="horizontal"
            android:visibility="gone">
            <TextView
                android:id="@+id/widget_messages_action"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:clickable="true"
                android:contentDescription="Abrir mensajes"
                android:focusable="true"
                android:gravity="center"
                android:textColor="#D6D6D6"
                android:textSize="14sp"
                 />
            <TextView
                android:id="@+id/widget_calls_action"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:clickable="true"
                android:contentDescription="Abrir llamadas"
                android:focusable="true"
                android:gravity="center"
                android:textColor="#D6D6D6"
                android:textSize="14sp"
                 />
        </LinearLayout>
    </LinearLayout>
    
    <ImageButton
        android:id="@+id/widget_open"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="start|top"
        android:background="@android:color/transparent"
        android:contentDescription="Abrir"
        android:padding="15dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_widget_open"
        android:tint="#8E8E8E" />
</FrameLayout>
