<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_static"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:visibility="gone" />

    <ViewFlipper
        android:id="@+id/widget_flipper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:autoStart="true"
        android:flipInterval="900"
        android:inAnimation="@anim/widget_fade_in"
        android:outAnimation="@anim/widget_fade_out">

        <ImageView
            android:id="@+id/widget_frame_0"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY" />

        <ImageView
            android:id="@+id/widget_frame_1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY" />

        <ImageView
            android:id="@+id/widget_frame_2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY" />

        <ImageView
            android:id="@+id/widget_frame_3"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY" />

        <ImageView
            android:id="@+id/widget_frame_4"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY" />

        <ImageView
            android:id="@+id/widget_frame_5"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY" />
    </ViewFlipper>

    <ImageView
        android:id="@+id/widget_text"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY" />

    <ImageButton
        android:id="@+id/widget_open"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="start|top"
        android:layout_marginStart="8dp"
        android:layout_marginTop="6dp"
        android:background="@android:color/transparent"
        android:contentDescription="Abrir"
        android:padding="13dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_widget_open" />

    <ImageButton
        android:id="@+id/widget_settings"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="end|top"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="6dp"
        android:background="@android:color/transparent"
        android:contentDescription="Ajustes"
        android:padding="13dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_widget_settings" />
    <!-- Zonas de acción transparentes; las etiquetas y el halo se dibujan en WidgetRenderer. -->
    <LinearLayout
        android:id="@+id/widget_action_row"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:orientation="horizontal"
        android:visibility="gone">
        <View
            android:id="@+id/widget_messages_action"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:contentDescription="Abrir mensajes"
            android:focusable="true" />
        <View
            android:id="@+id/widget_calls_action"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:contentDescription="Abrir llamadas"
            android:focusable="true" />
    </LinearLayout>
</FrameLayout>
