<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <ImageView
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:id="@+id/widget_overlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="12dp"
        android:background="@drawable/widget_action_chip"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="8dp">
        <TextView
            android:id="@+id/widget_latest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Sin mensajes nuevos"
            android:textColor="@color/widget_text"
            android:textSize="11sp" />
        <TextView
            android:id="@+id/widget_last_sync"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Widget listo"
            android:textColor="@color/widget_text_secondary"
            android:textSize="9sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/widget_action_chats"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/widget_action_chip"
            android:gravity="center"
            android:text="Chats"
            android:textColor="@color/widget_accent"
            android:textSize="12sp"
            android:textStyle="bold" />
        <Space android:layout_width="6dp" android:layout_height="1dp" />
        <TextView
            android:id="@+id/widget_action_calls"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/widget_action_chip"
            android:gravity="center"
            android:text="Llamadas"
            android:textColor="@color/widget_accent"
            android:textSize="12sp"
            android:textStyle="bold" />
        <Space android:layout_width="6dp" android:layout_height="1dp" />
        <TextView
            android:id="@+id/widget_action_refresh"
            android:layout_width="40dp"
            android:layout_height="36dp"
            android:background="@drawable/widget_action_chip"
            android:gravity="center"
            android:text="↻"
            android:textColor="@color/widget_accent"
            android:textSize="20sp" />
    </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="14dp"
        android:text="○ Sin sesión"
        android:textColor="@color/widget_accent"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/widget_unread"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="14dp"
        android:text="0 mensajes"
        android:textColor="@color/widget_text_secondary"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/widget_missed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="14dp"
        android:layout_marginTop="30dp"
        android:text="0 llamadas"
        android:textColor="@color/widget_text_secondary"
        android:textSize="10sp" />

</FrameLayout>
