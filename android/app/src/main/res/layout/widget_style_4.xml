<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_glass_light"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="12dp">
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextClock
            android:id="@+id/widget_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:includeFontPadding="false"
            android:textColor="#111111"
            android:textSize="34sp" />
        <TextClock
            android:id="@+id/widget_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="EEEE, d 'de' MMMM"
            android:format24Hour="EEEE, d 'de' MMMM"
            android:textColor="#444444"
            android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/widget_action_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/widget_messages_action"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/widget_circle_light"
            android:gravity="center"
            android:text="0"
            android:textColor="#111111"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/widget_calls_action"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/widget_circle_light"
            android:gravity="center"
            android:text="0"
            android:textColor="#111111"
            android:textSize="14sp" />
    </LinearLayout>
    <TextView
        android:id="@+id/widget_status"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginStart="10dp"
        android:background="@drawable/widget_pill_light"
        android:gravity="center"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="ONLINE"
        android:textColor="#111111"
        android:textSize="11sp" />
</LinearLayout>
