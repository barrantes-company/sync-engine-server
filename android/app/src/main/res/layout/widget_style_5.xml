<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_dark"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="12dp">
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextClock
            android:id="@+id/widget_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:includeFontPadding="false"
            android:textColor="#F4F7FC"
            android:textSize="26sp" />
        <TextClock
            android:id="@+id/widget_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="EEE, d MMM"
            android:format24Hour="EEE, d MMM"
            android:textColor="#C8C8C8"
            android:textSize="11sp" />
    </LinearLayout>
    <TextView
        android:id="@+id/widget_status"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:background="@drawable/widget_pill"
        android:gravity="center"
        android:text="ONLINE"
        android:textColor="#F4F7FC"
        android:textSize="12sp" />
    <TextView
        android:id="@+id/widget_calls_action"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/widget_circle_dark"
        android:gravity="center"
        android:text="0"
        android:textColor="#F4F7FC"
        android:textSize="12sp" />
    <TextView android:id="@+id/widget_messages_action" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <LinearLayout android:id="@+id/widget_action_row" android:layout_width="0dp" android:layout_height="0dp" android:orientation="horizontal" android:visibility="gone" />
</LinearLayout>
