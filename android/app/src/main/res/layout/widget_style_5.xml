<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050608">

    <ImageView
        android:layout_width="28dp"
        android:layout_height="20dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="22dp"
        android:src="@drawable/widget_mark" />
    <TextClock
        android:id="@+id/widget_clock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:fontFamily="sans-serif-light"
        android:format12Hour="h:mm"
        android:format24Hour="HH:mm"
        android:gravity="center"
        android:includeFontPadding="false"
        android:textColor="#F4F7FC"
        android:textSize="20sp" />
    
    <TextClock
        android:id="@+id/widget_date"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:format12Hour="EEE d MMM"
        android:format24Hour="EEE d MMM"
        android:visibility="gone" />
    <TextView
        android:id="@+id/widget_status"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    
    <LinearLayout
        android:id="@+id/widget_action_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">
        <TextView
            android:id="@+id/widget_messages_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mensajes"
            android:textColor="#7DDCFF"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/widget_calls_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Llamadas"
            android:textColor="#FF5CC4"
            android:textSize="14sp" />
    </LinearLayout>


</FrameLayout>
