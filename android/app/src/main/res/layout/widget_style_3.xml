<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#07111D">
    
    <ViewFlipper
        android:layout_width="match_parent"
        android:layout_height="78dp"
        android:layout_gravity="bottom"
        android:autoStart="true"
        android:flipInterval="1800"
        android:inAnimation="@anim/widget_fade_in"
        android:outAnimation="@anim/widget_fade_out">
        <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/widget_trails_0" />
        <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/widget_trails_2" />
        <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/widget_trails_4" />
    </ViewFlipper>
    
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:paddingBottom="16dp">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:orientation="vertical">
            <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:gravity="start"
            android:letterSpacing="0.22"
            android:text="SYNC"
            android:textColor="#6DD8FF"
            android:textSize="10sp" />
            <TextClock
            android:id="@+id/widget_clock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:gravity="start"
            android:includeFontPadding="false"
            android:textColor="#FFFFFF"
            android:textSize="30sp" />
            <TextClock
            android:id="@+id/widget_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:format12Hour="EEE d MMM"
            android:format24Hour="EEE d MMM"
            android:gravity="start"
            android:includeFontPadding="false"
            android:textColor="#C5D0E3"
            android:textSize="12sp" />
            <TextView
            android:id="@+id/widget_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="start"
            android:textColor="#F7F8FB"
            android:textSize="13sp"
            android:visibility="gone" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/widget_action_row"
            android:layout_width="112dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:orientation="vertical"
            android:visibility="gone">
            <TextView
                android:id="@+id/widget_messages_action"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Mensajes"
                android:textColor="#F7F8FB"
                android:textSize="13sp"
                 />
            <TextView
                android:id="@+id/widget_calls_action"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Llamadas"
                android:textColor="#F7F8FB"
                android:textSize="13sp"
                 />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
