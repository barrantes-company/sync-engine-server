<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E0E10">
    
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="28dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextClock
            android:id="@+id/widget_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:format12Hour="h:mm a"
            android:format24Hour="HH:mm"
            android:includeFontPadding="false"
            android:letterSpacing="-0.03"
            android:textColor="#F5F5F4"
            android:textSize="32sp"
             />
            <TextClock
            android:id="@+id/widget_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif"
            android:format12Hour="EEE d MMM"
            android:format24Hour="EEE d MMM"
            android:includeFontPadding="false"
            android:textColor="#A1A1AA"
            android:textSize="12sp"
             />
            <TextView
            android:id="@+id/widget_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:minHeight="48dp"
            android:textColor="#D4D4D8"
            android:textSize="14sp"
            android:visibility="gone" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/widget_action_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:orientation="vertical"
            android:visibility="gone">
            <TextView
                android:id="@+id/widget_messages_action"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minWidth="132dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:clickable="true"
                android:contentDescription="Abrir mensajes"
                android:focusable="true"
                android:gravity="center"
                android:textColor="#F5F5F4"
                android:textSize="14sp"
                 />
            <TextView
                android:id="@+id/widget_calls_action"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minWidth="132dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:clickable="true"
                android:contentDescription="Abrir llamadas"
                android:focusable="true"
                android:gravity="center"
                android:textColor="#F5F5F4"
                android:textSize="14sp"
                 />
        </LinearLayout>
    </LinearLayout>
    
    <ImageButton
        android:id="@+id/widget_open"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="start|top"
        android:background="@android:color/transparent"
        android:contentDescription="Abrir"
        android:padding="15dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_widget_open"
        android:tint="#BDBDBD" />
</FrameLayout>
