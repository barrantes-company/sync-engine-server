<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_light"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="10dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextClock
                android:id="@+id/widget_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:format12Hour="h"
                android:format24Hour="HH"
                android:includeFontPadding="false"
                android:textColor="#111111"
                android:textSize="40sp" />
            <TextClock
                android:id="@+id/widget_minutes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:format12Hour="mm"
                android:format24Hour="mm"
                android:includeFontPadding="false"
                android:textColor="#111111"
                android:textSize="40sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <TextView
                android:id="@+id/widget_status"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/widget_pill_light"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="ONLINE"
                android:textColor="#111111"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
    <TextClock
        android:id="@+id/widget_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:format12Hour="EEEE, d 'de' MMMM"
        android:format24Hour="EEEE, d 'de' MMMM"
        android:textColor="#333333"
        android:textSize="12sp" />
    <LinearLayout
        android:id="@+id/widget_action_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="end"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/widget_messages_action"
            android:layout_width="48dp"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/widget_pill_light"
            android:drawableStart="@drawable/ic_widget_chat_dark"
            android:drawablePadding="4dp"
            android:gravity="center"
            android:text="0"
            android:textColor="#111111"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/widget_calls_action"
            android:layout_width="48dp"
            android:layout_height="36dp"
            android:background="@drawable/widget_pill_light"
            android:drawableStart="@drawable/ic_widget_call_dark"
            android:drawablePadding="4dp"
            android:gravity="center"
            android:text="0"
            android:textColor="#111111"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
