{
  "version": "1.0.0",
  "architecture": "Hub-and-Spoke Decoupled",
  "endpoints": {
    "healthcheck": {
      "path": "/health",
      "method": "GET",
      "response": { "status": "ok", "service": "sync-engine-server-core" }
    },
    "login": {
      "path": "/api/v1/auth/login",
      "method": "POST",
      "payload": { "username": "string", "password": "string", "device_info": "object" },
      "response": { "status": "success", "data": { "user_id": "string", "access_token": "string" } }
    },
    "relay_event": {
      "path": "/api/v1/relay/event",
      "method": "POST",
      "payload": { "event_id": "string", "sender_id": "string", "event_type": "string", "payload": "object" },
      "response": { "status": "acknowledged", "event_id": "string", "ssot_synced": true }
    }
  }
}
