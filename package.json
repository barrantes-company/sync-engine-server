
steps:
  - name: 'node:22'
    id: 'validate-and-test'
    entrypoint: 'bash'
    args:
      - '-c'
      - |
        set -e

        echo "=== SYNC ENGINE 2.0 CI ==="
        node --version
        npm --version

        echo "=== Instalando dependencias ==="
        npm ci

        echo "=== Validando sintaxis ==="
        npm run lint

        echo "=== Pruebas existentes ==="
        npm test

        echo "=== Seguridad e integracion ==="
        npm run test:staging

        echo "=== Compilacion Webpack ==="
        npm run build

        echo "=== Validaciones completadas ==="

options:
  logging: CLOUD_LOGGING_ONLY

timeout: '1200s'
